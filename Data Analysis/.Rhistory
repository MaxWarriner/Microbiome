# BY HAND #########################################################
par <- optim(par=c(251, 10, log(37), log(961)),
fn=randint.ll,
data=sleepstudy)$par
L11 <- exp(par[c(3)])
par[3] <- L11                     # sigma.g0
par[4] <- sqrt(exp(par[4]))       # sigma.r
round(par, 4)
