data(sleepstudy)
# USING lmer ######################################################
mod <- lmer(Reaction ~ Days + (1|Subject), data=sleepstudy) # REML=T by default
View(sleepstudy)
View(mod)
fixef(mod)   # coefficients
VarCorr(mod) # sigma.g0 and sigma.r
View(sleepstudy)
