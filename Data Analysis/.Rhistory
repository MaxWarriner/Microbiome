#| echo: true
#| size: "tiny"
randint.ll <- function(par, data) {
beta0 <- par[1]; beta1 <- par[2];           # Coefficients
L11  <- exp(par[3]); var.r  <- exp(par[4]); # Covariance components
Sigma.gamma <- L11 * L11
subjects <- unique(data$Subject)               # Number of subjects
total.loglik <- 0                              # Start log-likelihood
for (s in subjects) { # For each subject
# Compute Residuals ######################################
dat.sub.i <- data[data$Subject == s, ]     # Subset the data
y.i <- dat.sub.i$Reaction                  # Observed y
fix.design.i <- cbind(1, dat.sub.i$Days)   # Design Matrix
yhat.i <- fix.design.i %*% c(beta0, beta1) # Predicted y
res.i <- c(y.i - yhat.i)                   # Residual vector
# Set Up Multivariate Gaussian ###########################
n.i <- length(y.i)     # Number of obs (subject i)
mu.i <- rep(0, n.i)    # Residuals have mean 0
rand.design.i <- matrix(1, nrow = n.i, ncol = 1) # Random intercept
Sigma.epsilon.i <- rand.design.i %*% Sigma.gamma %*% t(rand.design.i) + diag(var.r, n.i)
# Compute Likelihood ######################################
total.loglik <- total.loglik +          # Add to log-likelihood
dmvnorm(res.i, mean = mu.i, sigma = Sigma.epsilon.i, log = TRUE)
}
return(-total.loglik)
}
#| echo: true
#| size: "tiny"
